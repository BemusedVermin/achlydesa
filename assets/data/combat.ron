// Combat content — the move catalogue and per-archetype kits, compiled into `combat_core`
// MoveDefs by the `agents::combat` bridge. Authoring here keeps timing/effects/kits tunable
// without recompiling (the rest of the engine stays code; this is the data seam).
//
// A move is melee (`melee: true`) — gated to the attacker's zone when zone-gating is on — or it
// reaches any zone. `damage`, `knockback` (LineKnockback ticks), and `expose` (Exposed-window
// duration) are the effects; `requires_exposed` gates a payoff on the target carrying the window.
// Repositioning moves are generated by the bridge, not authored here.
(
    // The five action-tray moves shown on the fighting HUD — the player's default kit.
    tray: [1, 6, 5, 3, 4],

    moves: [
        (id: 1, name: "Strike",     startup: 3, active: 1, recovery: 2, priority: 2, melee: true, damage: 4),
        (id: 2, name: "Heavy Blow", startup: 6, active: 1, recovery: 3, priority: 1, melee: true, armored: true, damage: 9),
        (id: 3, name: "Feint",      startup: 3, active: 1, recovery: 2, priority: 1, expose: 8),
        (id: 4, name: "Riposte",    startup: 4, active: 1, recovery: 3, priority: 2, melee: true, requires_exposed: true, damage: 7),
        (id: 5, name: "Shove",      startup: 2, active: 1, recovery: 3, priority: 2, knockback: 4, damage: 2),
        (id: 6, name: "Loose",      startup: 2, active: 1, recovery: 2, priority: 2, damage: 3),
    ],

    // Which moves each kind of combatant fights with. The avatar and party are adventurers; named
    // NPCs are soldiers; predators bull in with melee; skittish prey kite at range.
    archetypes: [
        (name: "adventurer", kit: [1, 6, 5, 3, 4]),
        (name: "soldier",    kit: [1, 2, 5, 3, 4]),
        (name: "predator",   kit: [1, 2, 5]),
        (name: "prey",       kit: [6, 5]),
    ],
)
