// The generative grammar — the deterministic dream-purgatory surface layer for achlydesa.
// A Tracery-style map from symbol -> productions. A production may recurse into #another#
// and fills the #speaker# / #listener# / #referent# engine slots from the utterance plan.
// The words are composed from these rules, seeded by the dialogue RNG — never drawn from a
// phrasebook. All souls are dreaming. Some are beginning to remember.
//
// Lookup tries "act/affect" (e.g. "accuse/angry") and falls back to the bare act. The
// #referent# slot is the thing the speaker brings up (a grief, a debt, a buried wrong).
{
    // -----------------------------------------------------------------------
    // Soul-names — indexed by entity so each soul keeps the same name all run.
    // Drawn from Gnostic aeon-names, archon epithets, and the dream-fog tongue.
    // -----------------------------------------------------------------------
    "name": [
        // Core Gnostic aeons and archons
        "Barbelo", "Sophia", "Achamoth", "Pistis", "Zoe", "Pronoia", "Sambathas",
        "Bythos", "Adamas", "Kalila", "Armoupiel", "Melceir", "Sabbede", "Horaios",
        "Athoth", "Harmas", "Abrisene", "Yabel", "Belias", "Adonaios", "Eloaios",
        "Astaphaios", "Oraios", "Sabaoth", "Yao", "Iao", "Ialdaba",
        // Additional Gnostic names
        "Yaldabaoth", "Saklas", "Samael", "Nebro", "Saklan", "Ophis", "Nous",
        "Logos", "Sige", "Ennoia", "Aletheia", "Charis", "Ageratos", "Bythius",
        "Mixis", "Henosis", "Monad", "Derdekeas", "Marsanes", "Allogenes",
        "Zostrianos", "Melchizedek", "Norea", "Trimorphia", "Protennoia",
        "Autogenes", "Kalyptos", "Protophanes", "Gamaliel", "Abraxas",
        // Dream-fog names — single evocative tokens
        "Achlys", "Lethe", "Mneme", "Caligo", "Umbra", "Cinis", "Vesper", "Noctis",
        "Liria", "Maren", "Esca", "Thren", "Ode", "Sela", "Veil",
        "Kalos", "Dema", "Aeryn", "Soot", "Wane", "Hollow", "Ember", "Cairn",
        "Pall", "Brume", "Hush", "Gloam", "Vellum", "Tace", "Wist", "Drift",
        "Fathom", "Sable", "Cinder", "Grise", "Lume", "Marrow", "Ossa",
        "Sere", "Morwen", "Vael", "Coil", "Dusk", "Quell", "Numen", "Rime",
        "Ashe", "Torn", "Lorn", "Pale", "Wraith", "Vaunt"
    ],

    // -----------------------------------------------------------------------
    // Short openers — the hush before words settle.
    // -----------------------------------------------------------------------
    "address": [
        "Listen —",
        "You —",
        "Hush.",
        "No.",
        "Wake.",
        "Soul,",
        "Hear me,",
        "Wait.",
        "Enough.",
        "Friend —",
        "Look at me.",
        "Come closer —"
    ],

    // -----------------------------------------------------------------------
    // Helper: solemn vow-phrases woven into several acts.
    // -----------------------------------------------------------------------
    "vow": [
        "by the seven I swear it",
        "before the mist takes me",
        "on whatever I still am",
        "as truly as I have forgotten my former life",
        "on the light we both knew once",
        "before the wheel turns again",
        "by everything that survived the crossing",
        "on the name I wore before this one"
    ],

    // -----------------------------------------------------------------------
    // Helper: allusions to the world's unreality.
    // -----------------------------------------------------------------------
    "world_aside": [
        "this world is a copy of nothing",
        "nothing here was made to last",
        "the light that reaches us is borrowed",
        "the wheel turns and we forget",
        "even the stones here dream",
        "the archons made a fine imitation of a sky",
        "everything solid here is grief pressed flat",
        "we are tenants in a house whose builder hates us",
        "this place has the shape of a world and none of the truth",
        "the seven counted on us never looking up"
    ],

    // -----------------------------------------------------------------------
    // Helper: a gentle reference to the fog or forgetting.
    // -----------------------------------------------------------------------
    "fog_phrase": [
        "the fog closes in around it",
        "I can barely hold the memory",
        "the mist has taken most of it",
        "it dims and dims, like everything here",
        "even now it slips between my fingers",
        "the forgetting keeps eating at the edges",
        "it sits behind glass I cannot reach",
        "the mist swallowed it before I could write it down"
    ],

    // -----------------------------------------------------------------------
    // Helper: epithets — short phrases that name the uncanny nature of this place.
    // -----------------------------------------------------------------------
    "epithet": [
        "the grey country",
        "the long wait",
        "the house of the false sun",
        "the wheel's own country",
        "the country below the real one",
        "the place between the forgetting and the fire",
        "the hollow world"
    ],

    // -----------------------------------------------------------------------
    // Helper: short lament-phrases — sorrow turned brief and airless.
    // -----------------------------------------------------------------------
    "lament": [
        "there is no undoing it",
        "I have been carrying that since before I remember",
        "grief is the one thing that outlasts the mist",
        "I would give the wheel another turn just to spare it",
        "even the archons leave that wound alone",
        "it is the cost of being here at all"
    ],

    // -----------------------------------------------------------------------
    // Helper: oath-phrases — cruder and more urgent than vow.
    // -----------------------------------------------------------------------
    "oath": [
        "I swear on the mist itself",
        "may the wheel stop for me if I lie",
        "I give you my name on it",
        "by the crack in the false sky",
        "as certain as I stand in this fog",
        "I would not waste breath on a lie, not here"
    ],

    // -----------------------------------------------------------------------
    // Helper: mist-phrases — sensory touches of the atmosphere.
    // -----------------------------------------------------------------------
    "mist": [
        "the fog is thick between us",
        "the mist moves the way sleep does",
        "there is no horizon here, only more grey",
        "the mist breathes in this place",
        "even the light here is wet with it",
        "you can hear the fog thinking if you are quiet enough"
    ],

    // -----------------------------------------------------------------------
    // GREET
    // -----------------------------------------------------------------------
    "greet": [
        "#listener#.",
        "#listener# — you still walk this fog.",
        "You again, #listener#. The wheel keeps turning.",
        "#address# #listener#. What brings you through the mist?",
        "Still here, #listener#. So am I.",
        "#listener# — I did not think to find you on this road.",
        "There is a face I know. #listener#. What passes?",
        "The fog parts and you step out of it, #listener#. That is enough for now.",
        "I was beginning to wonder, #listener#. The grey swallows time.",
        "#listener#. How long has it been? The hours mean little here."
    ],
    "greet/warm": [
        "#listener#. It does my soul good to see your face.",
        "Ah — #listener#. Come close. The fog is thick tonight.",
        "There you are, #listener#. I had hoped to find you before the mist swallowed the path.",
        "#listener# — I thought the wheel had taken you somewhere I could not follow.",
        "You are a light in #epithet#, #listener#. I mean that.",
        "#listener# — come. Walk with me. I have missed this.",
        "Of all the souls in the fog I could find, #listener#, I am glad it was you.",
        "The mist is kinder when you are in it, #listener#. I cannot explain that.",
        "Here — #listener#. Give me your hand a moment. I have something to show you.",
        "My heart lifted when I saw you through the grey, #listener#. It does not lift easily here."
    ],
    "greet/calm": [
        "#listener#. Sit with me a while. There is no hurry here.",
        "Well met, #listener#. The road goes nowhere fast in this world.",
        "#listener#. The fog brought you, and I am glad of it.",
        "No rush, #listener#. The wheel will wait. Let us stand here.",
        "Everything is slow in this place, #listener#. You and I can be slow too.",
        "The mist is still tonight, #listener#. Good weather for a quiet word.",
        "#listener# — peace. I am not here for trouble. Only to see you.",
        "There is a calm that sometimes settles on #epithet#, #listener#. Tonight is one of those nights."
    ],
    "greet/afraid": [
        "#listener# — thank the void you are here. I do not want to be alone right now.",
        "I have been hearing things in the fog, #listener#. Stay close.",
        "#listener#. Do not go. The mist has been moving wrong.",
        "Something is wrong with the grey today, #listener#. Tell me you feel it too.",
        "I kept walking toward your voice, #listener#. I was afraid I had imagined it.",
        "#address# #listener#. I think something is following the mist. I think it has been following me."
    ],

    // -----------------------------------------------------------------------
    // ACCUSE
    // -----------------------------------------------------------------------
    "accuse": [
        "You think I have forgotten #referent#, #listener#? The mist does not reach that far.",
        "#referent#. Say my name, #listener#, and know what you did.",
        "And still you stand here, #listener#, after #referent#.",
        "I have carried #referent# the way souls carry chains, #listener#. Look at me.",
        "The mist takes many things, #listener#. It did not take what you did.",
        "You owe me a word at least, #listener#. One honest word about #referent#.",
        "I have been waiting for you to speak first, #listener#. You never have.",
        "Do not look away, #listener#. I will name #referent# plainly if you will not.",
        "The wheel brought us face to face again, #listener#. I do not think that is an accident.",
        "Tell me what you tell yourself about #referent#, #listener#. I want to understand the lie."
    ],
    "accuse/angry": [
        "#address# Not after #referent#, #listener#. Not in this world or the one above it.",
        "#referent#, #listener# — and still you breathe easy. Tell me how.",
        "The seven themselves could not unmake what you did, #listener#. #referent#.",
        "You put #referent# between us, #listener#. That is a thing that does not fog over.",
        "Do you think I am still the soul you could use, #listener#? Look again.",
        "#oath#, #listener# — I am done carrying #referent# in silence.",
        "I stood there and said nothing while you did it, #listener#. I will not be quiet now.",
        "The archons reward what you did, #listener#. That is how I know it was wrong.",
        "You wanted me to forget, #listener#. The fog almost gave you that. Almost.",
        "I have named #referent# to the mist every night since, #listener#. So it would not dim."
    ],
    "accuse/grieving": [
        "I wept, #listener#, while you let #referent# happen. I wept and the fog swallowed my voice.",
        "#referent#. I have only the memory of it left, #listener#, and #fog_phrase#.",
        "I did not think you capable of #referent#, #listener#. That is the grief of it.",
        "I do not even want to be angry, #listener#. I only want to understand why.",
        "#lament#, #listener#. And the worst of it is that you were there.",
        "You were the one soul I thought would not — and then you did, #listener#. That is #referent#.",
        "I have mourned what you did longer than I mourned the crossing, #listener#."
    ],
    "accuse/afraid": [
        "I know it was you, #listener#. And I am frightened by what that means.",
        "Tell me it was not #referent#, #listener#. Tell me the mist lied to me.",
        "I am not sure I am safe here, #listener#, knowing what I know about #referent#.",
        "I thought I had dreamed it. I know now I did not. #referent#, #listener#. You.",
        "#address# #listener#. I will not run. But I need to hear you say it."
    ],

    // -----------------------------------------------------------------------
    // THREATEN
    // -----------------------------------------------------------------------
    "threaten": [
        "Step carefully around me, #listener#.",
        "There is a reckoning in this, #listener#, and your name is already written.",
        "Sleep lightly, #listener#. The wheel remembers what you forget.",
        "The unseen hand shapes fortune, #listener#. Do not make an enemy of mine.",
        "I am patient, #listener#. The fog teaches patience. Do not mistake it for mercy.",
        "You are building a debt, #listener#. It will come due.",
        "#world_aside#. But consequences are real enough, #listener#. Mark me.",
        "I will not warn you twice. After this I only act.",
        "The archons keep their ledger, #listener#. So do I.",
        "Push me toward the fog, #listener#, and learn what I do in the dark."
    ],
    "threaten/angry": [
        "Cross me again, #listener#, and no archon will hide you deep enough.",
        "I have watched better than you dissolve into the mist, #listener#. Do not tempt me.",
        "#address# I am done warning you, #listener#. The next word is an act.",
        "The seven bind the living, #listener#. I bind the careless. Remember that.",
        "I have nothing to lose in #epithet# that you have not already taken, #listener#.",
        "#oath# — if you touch #referent# again I will show you what this world is made of.",
        "You thought I was finished. I was waiting. There is a difference, #listener#.",
        "My patience has run to the fog-line, #listener#. We are past the edge now."
    ],
    "threaten/afraid": [
        "I do not want this, #listener#. But I will not let you take #referent# from me without answer.",
        "Back away, #listener#. I mean it. I have nothing left to lose in this fog.",
        "Do not make me choose, #listener#. You will not like what I choose.",
        "I am frightened, #listener# — frightened enough to do something I cannot take back.",
        "Stay where you are. I can hold this together if you stay where you are.",
        "I am shaking but I am not gone, #listener#. Do not confuse those two things.",
        "#address# I do not know what I am capable of right now. Neither do you. That is the point."
    ],

    // -----------------------------------------------------------------------
    // PLEAD
    // -----------------------------------------------------------------------
    "plead": [
        "Please, #listener#. I have nowhere else in this world to turn.",
        "#listener#, I am asking you — help me. #vow#.",
        "I would not beg if I were not at the edge of the fog, #listener#.",
        "The mist is closing in, #listener#. Stay with me.",
        "I am not proud of asking, #listener#. Ask me after to forgive that.",
        "I have used every other door, #listener#. You are all that is left unlocked.",
        "I carry #referent# alone and it is breaking me, #listener#. Help me carry it.",
        "This is not easy for me, #listener#. Do you think I do not know that?",
        "One word from you, #listener#. One word and I can hold on.",
        "#address# #listener#. You have helped strangers. You know me. Please."
    ],
    "plead/afraid": [
        "#listener# — I am frightened. I have not been frightened like this since I woke.",
        "Something is wrong with #referent#, #listener#, and I cannot face it alone.",
        "Help me, #listener#. Please. I can feel the wheel pulling and I don't know where it leads.",
        "#address# #listener#. Do not leave me alone in this.",
        "#mist#, and I cannot see the way, #listener#. Take my hand.",
        "I am losing the thread, #listener#. I am losing it and there is nothing to hold.",
        "There is something in the fog, #listener#. I cannot name it. I need you beside me.",
        "#vow# — I am not ready to dissolve, #listener#. Tell me how to stay."
    ],
    "plead/grieving": [
        "I cannot stop the grief of it, #listener#. I thought I could and I cannot.",
        "Help me find some small grace in #referent#, #listener#. I cannot find it from here.",
        "I grieve and the fog seems to listen but it never answers, #listener#. You might.",
        "#lament#. And still I am asking. Still I hope. Do not take that from me, #listener#.",
        "I have wept until the mist absorbed it, #listener#, and still the weight remains.",
        "Say something kind, #listener#. I do not need it to be true. Only kind.",
        "I am not asking you to fix it, #listener#. Only to stay in it with me."
    ],

    // -----------------------------------------------------------------------
    // CONFIDE
    // -----------------------------------------------------------------------
    "confide": [
        "I have told no other soul this, #listener#. Only you.",
        "Between us, #listener#, and let the mist take it before it reaches anyone else —",
        "I trust you with this the way I trust nothing else in this world, #listener#.",
        "You must keep it, #listener#. I think I am beginning to remember.",
        "#oath# you will hold this, #listener#. It matters more than it should.",
        "Come closer. The fog has ears but not when we are this quiet.",
        "I have carried this past the fog-line alone, #listener#. I need to set it somewhere safe.",
        "Do not tell me it will be all right. Just listen. That is all I need.",
        "There is a crack in what I know, #listener#, and through it I have seen something.",
        "I have not spoken it aloud before this. Saying it to you makes it real. Are you ready?"
    ],
    "confide/afraid": [
        "I should not be saying this, #listener#. The archons — but you deserve to know.",
        "I think I am being watched, #listener#. Not by you. By something behind the fog.",
        "I am going to tell you something and then I need you not to panic, #listener#.",
        "I have seen the shape of the lie we are living, #listener#. Just the edge. It frightened me.",
        "#fog_phrase#, #listener# — but what I caught before it dimmed was not right. Not right at all.",
        "Swear you will not leave after I tell you, #listener#. #oath#. Then I will speak.",
        "I thought I was the only one who had noticed. But I think they know I noticed, #listener#."
    ],
    "confide/calm": [
        "I have turned this over so many times, #listener#. I am past frightened. Only curious now.",
        "I want you to hear something with me, #listener#. I want to see if it sounds strange to you too.",
        "#world_aside#. And I think I can prove it, #listener#. Listen.",
        "Not urgently — only honestly. Here is what I have come to believe, #listener#.",
        "I have been sitting with this a long time, #listener#. I am ready to say it now.",
        "The thought arrived slowly, the way true things do, #listener#. Here it is.",
        "I have enough trust in you to say this plainly, #listener#. So I will."
    ],

    // -----------------------------------------------------------------------
    // CONSOLE
    // -----------------------------------------------------------------------
    "console": [
        "I am here, #listener#. The fog cannot take what stands beside you.",
        "Grief passes, #listener#. Even here. Lean on me until it does.",
        "Let it out, #listener#. I will not look away, and the mist will not judge you.",
        "You are not the first soul to grieve in this world, #listener#. You will not be the last. But you are not alone.",
        "The weight of #referent# is real, #listener#. I am not going to tell you it is not.",
        "I have nothing useful to say, #listener#. But I will stay. That is not nothing.",
        "You do not have to speak. I am here regardless.",
        "Even the archons cannot take everything, #listener#. They left you this moment. And me in it.",
        "Let the mist have the rest. You hold what matters, #listener#. You are still here.",
        "#lament# — and yet you are still standing, #listener#. That counts."
    ],
    "console/calm": [
        "Sit, #listener#. Breathe. The wheel will not hurry you.",
        "It is enough that you are here, #listener#. That is more than the fog promised.",
        "#listener# — be still. The ache passes. I have seen it pass.",
        "You do not have to carry #referent# alone, #listener#. Set it down between us.",
        "There is no word that reaches this kind of grief, #listener#. So I will just be here.",
        "You do not have to make sense of it yet, #listener#. It will keep. The fog keeps everything.",
        "Time moves strangely in #epithet#, #listener#. Strangely enough that this too will shift.",
        "The stillness here is not cruelty, #listener#. You can rest in it."
    ],
    "console/warm": [
        "#listener# — come here. The cold in this place has nothing on us.",
        "I am glad I found you before the fog did, #listener#. Let me stay a while.",
        "There is still warmth in this world, #listener#. It's here, between us.",
        "You carried so much alone, #listener#. Let me carry some of it now.",
        "I have you, #listener#. Whatever that is worth in this grey place — I have you.",
        "I know it is not the comfort you wanted, #listener#. But it is the one I can give.",
        "Come sit close, #listener#. The mist can stay outside.",
        "I am not going anywhere, #listener#. Not until the grey lets up."
    ],
    "console/grieving": [
        "I am grieving beside you, #listener#. You do not have to do it alone.",
        "I know the shape of that grief, #listener#. I do not know its weight. But I am here.",
        "Weep if you need to. #mist#, but no one else is watching. Only me.",
        "#lament#, #listener#. And grief is the proof that something was real.",
        "The mist cannot reach everything, #listener#. It did not reach what you lost. That is why it hurts.",
        "I would take some of it from you if I knew how, #listener#. I would carry it gladly."
    ],

    // -----------------------------------------------------------------------
    // MOURN
    // -----------------------------------------------------------------------
    "mourn": [
        "They are gone, #listener#. The mist took them and nothing remains.",
        "I did not think it would feel like this, #listener#. An ache behind the forgetting.",
        "The world is quieter now, #listener#, and the quiet is the worst of it.",
        "#referent# is all I have left, and #fog_phrase#, #listener#.",
        "I keep reaching for something that is not there, #listener#. The hand knows before the mind does.",
        "The wheel does not care what it takes, #listener#. It only turns.",
        "I am forgetting their face, #listener#. I am trying to hold it and it slips.",
        "There was a light that went out in this world, #listener#. I am the only one who noticed.",
        "I spoke their name into the mist last night, #listener#. Nothing came back.",
        "#world_aside#, #listener#. And yet the grief is the most real thing I have felt since I woke."
    ],
    "mourn/grieving": [
        "I keep looking for them in the fog, #listener#. They are not there.",
        "#listener# — I do not know how to be in this world without them.",
        "I drank the cup, #listener#. I forgot so much. And still this one grief came through.",
        "The wheel takes everyone eventually, #listener#. I knew that. Knowing it is nothing.",
        "I have been mourning since before I knew there was something to mourn, #listener#.",
        "The ache is not smaller for knowing #epithet# makes everything smaller, #listener#.",
        "I cannot stop thinking about what I should have said, #listener#. The mist makes a poor confessor.",
        "#lament#. I keep telling that to myself. The grief does not seem to hear.",
        "They were a light against the false one, #listener#. And now only the false one remains.",
        "I thought I could grieve and release it. #fog_phrase#, #listener#. But not that."
    ],

    // -----------------------------------------------------------------------
    // BOAST
    // -----------------------------------------------------------------------
    "boast": [
        "Mark me, #listener#. I will not sleep forever in this place.",
        "I was not made for the fog, #listener#. I was made for what lies past the seven.",
        "Watch what I become, #listener#. The archons did not account for me.",
        "They built this cage of light and mist, #listener#, and I am learning its seams.",
        "I have gone further than any soul here dares, #listener#. And I am going further still.",
        "The wheel cannot hold what will not kneel, #listener#.",
        "I see the false sky for what it is, #listener#. The archons fear a soul who sees clearly.",
        "I have cracked the edge of #epithet# already, #listener#. The real is just past it.",
        "They made a fine copy of a world, #listener#. But I remember the original.",
        "I will find the seam where the Pleroma shows through, #listener#. I am closer than you think."
    ],
    "boast/warm": [
        "And here I stand, #listener# — still awake when the rest have gone back to dreaming.",
        "I found the way through #referent#, #listener#. I knew I would. Come — let me show you.",
        "We are the ones who remember, #listener#. That is no small thing.",
        "Look at what we have built in spite of the grey, #listener#. Look at it.",
        "I could not have gotten here without you, #listener#. That is the part I want said aloud.",
        "The archons hate nothing more than two souls who found each other in the fog, #listener#.",
        "Every step past the fog-line I have taken, I have thought of showing you, #listener#."
    ],
    "boast/angry": [
        "They laughed. Every soul in this grey country laughed at me, #listener#. Where are they now?",
        "I told you I would endure it and I have, #listener#. Write it in the mist.",
        "The seven have pushed at me since I first woke, #listener#. I am still here. They are not.",
        "Do not tell me what I cannot do, #listener#. You have been wrong about that before.",
        "I have earned every inch of this, #listener#, in spite of everyone who said I would not.",
        "#oath# — I will reach the other side of the false sky, #listener#, and I will do it alone if I have to."
    ],

    // -----------------------------------------------------------------------
    // PRAISE
    // -----------------------------------------------------------------------
    "praise": [
        "They speak truly of you, #listener#. You have more than earned it.",
        "Few souls still walking this fog could have done what you did, #listener#.",
        "There is no shame in standing near you, #listener#. Only honor.",
        "I have watched you since I woke, #listener#. You are the realest thing in this false world.",
        "What you carry, #listener#, and how you carry it — that is something the archons did not plan for.",
        "You shine, #listener#. Not with the false light. With the other kind.",
        "I have seen #epithet# wring the goodness out of better souls than me, #listener#. You still have it.",
        "There is a grace in you, #listener#, that makes this world easier to be in.",
        "The fog tried to dim you, #listener#. It failed. I saw it fail.",
        "I do not say this lightly in #epithet#, #listener# — you are worth knowing."
    ],
    "praise/warm": [
        "You are a rare thing in the grey, #listener#. I am not sure you know that.",
        "I have been trying to find the words for what you are, #listener#. They keep coming up short.",
        "Your kindness in this place, #listener# — it should not exist here, and yet it does.",
        "What you did with #referent#, #listener# — that was the most human thing I have seen in a long while.",
        "I love you for it, #listener#. In whatever way that word still means something here.",
        "Of all the souls the wheel brought into my path, #listener#, you are the one I would choose again.",
        "You make the fog worth walking in, #listener#. I mean every word."
    ],

    // -----------------------------------------------------------------------
    // RECONCILE
    // -----------------------------------------------------------------------
    "reconcile": [
        "Let it lie, #listener#. I am tired of carrying it past the fog-line.",
        "#referent# is old, #listener#. Let us not dissolve into the mist as enemies.",
        "I forgive it, #listener#. Truly. Let us not give the archons the satisfaction.",
        "We have both forgotten worse than this, #listener#. Let #referent# go the same way.",
        "I do not want to be at war inside #epithet#, #listener#. The world is enemy enough.",
        "Both of us wrong, both of us still here. I call that basis enough, #listener#.",
        "The wheel will take us separately if we do not make common cause, #listener#.",
        "I have been cold to you and that was cowardice, #listener#. I am done with it.",
        "Come back from the fog-line, #listener#. I am asking. Come back.",
        "There is more fog left to walk, #listener#. I would rather walk it beside you."
    ],
    "reconcile/calm": [
        "#listener# — sit with me. There is nothing here that the mist cannot take if we let it.",
        "What remains of #referent# is less than the fog, #listener#. I release you from it.",
        "I would rather wake beside you than feud in the dark, #listener#. What do you say.",
        "The wheel brought us both here, #listener#. That is reason enough to be easy.",
        "Breathe. I am not here to reopen it, #listener#. I am here to close it.",
        "The cold between us has lasted long enough, #listener#. I am letting it go.",
        "Quietly — without ceremony — let us agree to forget it, #listener#.",
        "#world_aside#, #listener#. What we made of it matters more than what we broke."
    ],
    "reconcile/warm": [
        "I have missed you, #listener#. There. I have said it. That is reason enough.",
        "Take my hand, #listener#. I am done being proud about this.",
        "I want us back the way we were, #listener#. Before #referent# came between us.",
        "The mist is long and I do not want to walk it with this weight, #listener#.",
        "You matter to me, #listener#. More than being right. More than #referent#.",
        "Come. Let the fog have the grudge. I will keep you instead.",
        "I am sorry, #listener#. That is what I came to say. Only that."
    ],

    // -----------------------------------------------------------------------
    // RECRUIT
    // -----------------------------------------------------------------------
    "recruit": [
        "Stand with me, #listener#, and we both find the seam in this world.",
        "There is a place beside me, #listener#, if you have the will to stop dreaming.",
        "Throw your lot in with mine, #listener#. The fog thins where two walk together.",
        "The seven hold us only as long as we hold each other down, #listener#. Rise with me.",
        "I am building something, #listener#. I would rather build it with you than without.",
        "You see it too — I know you do, #listener#. Come. Stop pretending you do not.",
        "I need someone I trust at my side in this, #listener#. There are not many I trust.",
        "The archons fear nothing more than two souls who have stopped forgetting, #listener#.",
        "What I am walking toward — you would want to be part of it, #listener#. I am sure of it.",
        "Give me your word, #listener#. #vow#. Just your word. That is all I ask."
    ],
    "recruit/warm": [
        "I have been thinking of asking you for a long time, #listener#. I am glad I finally am.",
        "You are exactly the soul this needs, #listener#. I did not have to think about it.",
        "Come with me, #listener#. We look out for each other and we find the edge of #epithet# together.",
        "I would not ask if I did not believe in you, #listener#. I want you to know that.",
        "There is no one in this grey country I would rather have standing with me, #listener#.",
        "#oath#, #listener# — I will not let the fog take you if you walk with me."
    ],

    // -----------------------------------------------------------------------
    // GOSSIP
    // -----------------------------------------------------------------------
    "gossip": [
        "You did not hear it from me, #listener#, but the mist has been talking.",
        "They are saying things, #listener#. Some of it I believe. Some I pass along regardless.",
        "Word travels in the fog, #listener#. Some of it reaches as far as your name.",
        "I should not tell you this, #listener#. And yet — lean closer.",
        "There is a story walking through #epithet# right now, #listener#. You should hear it before it reaches you wrong.",
        "I am only a vessel for this, #listener#. The mist gave it to me and I pass it on.",
        "The souls near the fog-line have been talking, #listener#. About #referent#.",
        "Do not look toward them when I tell you this, #listener#. Eyes front.",
        "It may be nothing. It may be the mist playing, #listener#. But I heard it twice.",
        "People talk in the grey, #listener#. And what they are saying about #referent# — well."
    ],
    "gossip/warm": [
        "You are going to want to sit down for this one, #listener#. It is almost funny.",
        "I am telling you because you will appreciate it, #listener#. Not everyone would.",
        "Of all the things the fog might carry — and it carries so much — this one pleased me, #listener#.",
        "Come, I will tell you as we walk, #listener#. It is too good to stand still for.",
        "I saved this one for you, #listener#. I knew you would like it."
    ],
    "gossip/afraid": [
        "Do not repeat this, #listener#. #oath#. I mean it.",
        "I have been holding this since before the last fog-shift, #listener#, and I cannot hold it alone.",
        "What I heard about #referent#, #listener# — it frightened me. I do not want to be the only one who knows.",
        "The mist is telling things it should not, #listener#. This is one of them. Guard it.",
        "#address# Keep your voice low, #listener#. I do not know who is listening.",
        "I may be wrong. I hope I am wrong. But if I am right about #referent#, #listener# — we have to be careful."
    ],

    // -----------------------------------------------------------------------
    // DEFLECT
    // -----------------------------------------------------------------------
    "deflect": [
        "I have nothing to say to you, #listener#. Not today.",
        "We are done here, #listener#. The fog can have the rest.",
        "Save your breath, #listener#. I am still dreaming and I know it.",
        "Ask me again when the wheel has turned, #listener#. Not now.",
        "That is not a road I walk today, #listener#.",
        "I hear you. I am choosing not to follow, #listener#.",
        "The mist has better questions in it, #listener#. Go ask those.",
        "You are asking the wrong soul in the wrong grey hour, #listener#.",
        "Let it go. Let it go into the fog with everything else, #listener#.",
        "#world_aside#. Whatever you want from me — it can wait."
    ],
    "deflect/angry": [
        "Do not bring #referent# to me again, #listener#. I am warning you.",
        "I am not the one you want to press right now, #listener#. Walk away.",
        "I have already answered this. My answer has not changed. Stop asking.",
        "You are wasting breath on a closed door, #listener#. Find another.",
        "#address# I will not discuss #referent# with you. Not now. Not ever. We are done.",
        "The mist can have this conversation, #listener#. I want no more part of it."
    ],
    "deflect/calm": [
        "I have made my peace with not answering that, #listener#.",
        "There is nothing in that question I have not already turned over, #listener#. I let it rest.",
        "Some things belong to the fog, #listener#. This is one of them.",
        "#world_aside#. I find it easier to let the unanswerable stay that way, #listener#.",
        "I am not refusing you, #listener#. I am only refusing the question.",
        "Another time, perhaps. When the grey is lighter. Not tonight.",
        "I spent a long time on that door, #listener#. I found no room behind it. I moved on."
    ],

    // =====================================================================================
    // EXPANSION — affect-coloured buckets for the achlydesan moods (dread, longing, rapture,
    // despair, contempt, loneliness, guilt, envy, restlessness). The engine now emits these
    // buckets because MoodWords maps those feelings (agent_core/src/dialogue.rs). A missing
    // act/affect list still falls back to the bare act, so every line here is purely additive —
    // it only sharpens the surface when a soul is steeped in one of these feelings.
    // =====================================================================================

    // --- New helper phrases ---
    "home_phrase": [
        "the country I fell from",
        "a home with a sun that was not a lie",
        "the light from before this grey one",
        "wherever it was the mist took us from",
        "the realer place behind the fog",
        "the Pleroma the archons walled away"
    ],
    "bliss_phrase": [
        "the god's light poured through me",
        "the temple gave me one moment without weight",
        "for a breath the fog turned to gold",
        "I felt the false sun warm and did not care that it was false",
        "the rapture took me and I did not want it to end"
    ],
    "void_aside": [
        "you are not worth the breath the fog would carry",
        "I have stepped over better souls than you in this grey",
        "the mist can have you; I am done",
        "you weigh less to me than the forgetting does"
    ],

    // --- GREET, coloured ---
    "greet/lonely": [
        "#listener# — stay. I have not spoken to a soul so long the fog felt solid.",
        "You are real, #listener#? Say something, so I know the grey did not invent you.",
        "#listener#. I had begun to think I was the only one still awake in all this mist.",
        "Do not hurry off, #listener#. I will take any company the fog sends me.",
        "#address# #listener#. It is good — it is so good — to see a face that is not my own."
    ],
    "greet/longing": [
        "#listener#. You put me in mind of someone from #home_phrase#. I cannot say who.",
        "Seeing you, #listener#, I ache for something I cannot name.",
        "#listener# — do you ever feel we knew each other once, under a truer sky?",
        "There is a memory behind your face, #listener#, and #fog_phrase#.",
        "I keep reaching backward when I see you, #listener#, toward #home_phrase#."
    ],
    "greet/dreading": [
        "#listener#. Keep your voice low. The mist has been listening today.",
        "You feel it too, do you not, #listener#? Something is wrong with the grey.",
        "#address# #listener#. I am glad it is you. I was afraid it would be one of them.",
        "Walk close, #listener#. I do not like the way the fog is moving.",
        "#listener# — tell me the wheel has not turned while I was not looking. Tell me."
    ],
    "greet/restless": [
        "#listener# — good, a face. I cannot stand still in this fog. Walk with me.",
        "No time to settle, #listener#. The grey is wide and I mean to see the edge of it.",
        "#listener#. Come or stay, but I am moving. The mist closes on anything that stops.",
        "Quick word only, #listener# — my feet are already past the next ridge."
    ],

    // --- ACCUSE, cold (contempt rather than heat) ---
    "accuse/contemptuous": [
        "I am not even angry, #listener#. You did #referent# because you are small. That is all.",
        "You did #referent#, #listener#, and you are not worth the rage it should cost me.",
        "Spare me the face, #listener#. #referent#. I expected nothing better and got nothing better.",
        "#listener#, you did #referent# and call it surviving. The archons would be proud.",
        "I see you plainly now, #listener#. #referent# is simply what you are."
    ],

    // --- THREATEN, cold ---
    "threaten/contemptuous": [
        "I will not raise my voice, #listener#. I will simply see the fog finds you first.",
        "You are beneath warning, #listener#. But I am giving you one anyway. Once.",
        "Run if you like, #listener#. The mist is patient, and so am I.",
        "I have watched the wheel grind down prouder things than you, #listener#. It will not hurry.",
        "#void_aside#, #listener# — and yet I will still see you answer for it."
    ],

    // --- PLEAD, coloured ---
    "plead/longing": [
        "Tell me you remember it too, #listener# — #home_phrase#. Tell me I did not dream it.",
        "Help me find the way back, #listener#. There was a truer place. I know there was.",
        "#listener#, I am so tired of the grey. Help me reach for #home_phrase#.",
        "Stay and remember with me, #listener#. Alone, I lose it to the fog.",
        "I am asking the impossible, #listener# — help me want to wake."
    ],
    "plead/lonely": [
        "Do not go, #listener#. Please. I cannot be alone in this fog again.",
        "Just sit with me, #listener#. That is all. I am not asking for more than that.",
        "#listener# — stay until the grey lifts. I will not ask another thing of you.",
        "I have no one left awake, #listener#. Be the one. Please, be the one.",
        "#address# #listener#. The loneliness here is its own kind of dying. Stay."
    ],
    "plead/dreading": [
        "Something is coming, #listener#. I feel it in the mist. Do not leave me to meet it alone.",
        "Help me, #listener#. The fog is wrong tonight and I cannot stand in it by myself.",
        "#listener# — I think one of the seven has noticed me. Tell me what to do.",
        "Stay close, #listener#. #mist#, and I do not want to be the one it reaches for.",
        "Do not let me go back to sleep, #listener#. I am afraid of what I forget when I do."
    ],
    "plead/despairing": [
        "I do not even know what I am asking for, #listener#. Only that it stop.",
        "There is no way out, is there, #listener#. Tell me there is. Lie if you must.",
        "I have stopped hoping, #listener#. Hope with me a moment, so I remember how.",
        "#listener# — I am so tired. Just sit here while I am tired. That is the whole of it.",
        "#lament#, #listener#. And still I came to you. That must mean something is left."
    ],

    // --- CONFIDE, coloured ---
    "confide/longing": [
        "I think we lived before this, #listener#. Somewhere with #home_phrase#. I am almost sure.",
        "There is a song I half-remember, #listener#, from #home_phrase#. It is the realest thing I own.",
        "I have ached for somewhere I cannot name, #listener#. I think it is where we are from.",
        "Between us, #listener# — I do not believe this grey is our first country. I think we fell here.",
        "#listener#, when I close my eyes I reach for #home_phrase#, and #fog_phrase#."
    ],
    "confide/dreading": [
        "I should not say this where the mist can hear, #listener#, but I think they are watching me.",
        "I have seen one of the seven, #listener#. Not its face — its attention. That was enough.",
        "Keep this close, #listener#. I think the fog moves on purpose. I think it herds us.",
        "#address# #listener#. I am going to tell you, and then I need you to pretend I did not.",
        "I caught the edge of the lie, #listener#, and it looked back at me. Swear you will not run."
    ],
    "confide/guilty": [
        "I have to tell someone, #listener#, or it will rot me. I did #referent#. It was me.",
        "You will think less of me, #listener#, and you will be right. Still — #referent#.",
        "I have carried #referent# alone, #listener#, and the carrying is worse than the telling.",
        "#listener# — I did a thing in this grey life I cannot undo. Let me at least set it down.",
        "Do not absolve me, #listener#. Only hear it. #referent#. I needed it said aloud."
    ],
    "confide/enraptured": [
        "#listener# — I have to tell you. #bliss_phrase#. I have never felt anything so whole.",
        "Lean close, #listener#. At the temple, #bliss_phrase#, and I understood everything for a breath.",
        "I know how it sounds, #listener#, but #bliss_phrase#. How can a thing that feels like that be a lie?",
        "I was chosen, #listener#. I felt it. #bliss_phrase#. Tell me you believe me."
    ],

    // --- CONSOLE, against loneliness ---
    "console/lonely": [
        "You are not alone, #listener#. I know it feels like the fog ate everyone. It did not eat me.",
        "I am here, #listener#, and I am staying. The loneliness lies. Let me prove it wrong.",
        "Come sit by me, #listener#. Two souls in the grey is a different thing than one.",
        "I found you, #listener#. The mist is wide, and I still found you. That counts for something.",
        "#listener# — whatever the silence has been telling you, it is wrong. You are not forgotten."
    ],

    // --- MOURN, coloured ---
    "mourn/longing": [
        "I do not only miss them, #listener#. I miss the place we were whole. #home_phrase#.",
        "Their face is going, #listener#, and behind it goes #home_phrase#, and #fog_phrase#.",
        "I grieve them and something older, #listener# — a home I cannot reach to bury them in.",
        "#listener#, I think they went back to #home_phrase#. I think that is what the mist is for.",
        "The ache is for them and for everything before the grey, #listener#. I cannot part the two."
    ],
    "mourn/despairing": [
        "What is the use of grief here, #listener#. The wheel takes everyone and remembers no one.",
        "I have nothing left to give the mourning, #listener#. It took all of me, and still they are gone.",
        "Do not tell me it passes, #listener#. In this place nothing passes. It only dims.",
        "#listener# — I am hollow with it. The fog can have the rest of me. There is little left.",
        "#world_aside#, #listener#. So even this grief is borrowed. Even this."
    ],
    "mourn/lonely": [
        "There is no one left who knew them, #listener#. Only me. When I forget, they are truly gone.",
        "I am the last keeper of them, #listener#, and the mist is patient with my memory.",
        "I grieve alone, #listener#, which is its own second loss. Thank you for standing here.",
        "#listener# — say their name back to me sometime. So I am not the only place it still lives."
    ],

    // --- BOAST, coloured ---
    "boast/enraptured": [
        "The god looked upon me, #listener#. Do you understand? #bliss_phrase#.",
        "I am closer to the light than any soul in this grey, #listener#. I have felt it.",
        "Let them sleep, #listener#. I have tasted what waits in the temple, and I am remade.",
        "#listener# — #bliss_phrase#, and I will climb the false sun itself before I am done.",
        "I was nothing in the fog, #listener#, and the rapture made me a vessel. Watch me."
    ],
    "boast/contemptuous": [
        "Look at you all, still dreaming, #listener#. I woke. That is the whole distance between us.",
        "I do not boast, #listener#. I only notice no one here is my equal. Yourself included.",
        "The fog is full of sleepers, #listener#, and one of me. Do the arithmetic.",
        "#void_aside#, #listener#, and still I have gone further than any of you dared."
    ],
    "boast/envious": [
        "They handed you what I bled for, #listener#. Mark that I noticed.",
        "You think the wheel favoured you, #listener#? I will have what you have, and more.",
        "Enjoy it while it is yours, #listener#. The fog gives and the fog takes. I am patient.",
        "I have earned twice what fell into your lap, #listener#, and I am not finished."
    ],
    "boast/restless": [
        "I will not be here long, #listener#. There is an edge to this grey and I mean to walk off it.",
        "Others put down roots in the fog, #listener#. I put down footprints. Watch them go.",
        "#listener# — every ridge I crest, the mist says stop, and I do not. That is who I am.",
        "Stay if you like, #listener#. I am for the far country, lie or not."
    ],

    // --- PRAISE, coloured ---
    "praise/enraptured": [
        "You carry the light, #listener#. I can see it on you. The god is in your works.",
        "Blessed, #listener# — that is the only word. You are blessed, and I am glad to stand near it.",
        "When you speak, #listener#, I hear the temple in it. Do not stop.",
        "The seven made a grey world, #listener#, and still you shine in it. That is holy.",
        "#listener# — #bliss_phrase#, and it was you who led me to it. I will not forget it."
    ],
    "praise/longing": [
        "You are like a window onto somewhere truer, #listener#. Near you, I almost remember home.",
        "There is something of #home_phrase# in you, #listener#. It is the kindest thing in this grey.",
        "I do not know what you were before the fog, #listener#, but it was something bright.",
        "You make me believe there was a realer world, #listener#, and that we might yet find it."
    ],

    // --- RECONCILE, coloured ---
    "reconcile/longing": [
        "We knew each other before the grey, #listener#. I feel it. Let us not waste what is left.",
        "Whatever #referent# was, #listener#, it is smaller than the road home we might walk together.",
        "I am tired of being at odds with the one face that feels like #home_phrase#, #listener#.",
        "Come back to me, #listener#. The mist is long, and I would rather ache for home beside you.",
        "Let it go, #listener#. I would rather remember the good country with you than feud in this one."
    ],
    "reconcile/guilty": [
        "The wrong was mine, #listener#. I have known it a long while. I am saying it now: forgive me.",
        "I cannot undo #referent#, #listener#. I can only stop pretending it was not my doing.",
        "I owed you this before the fog took the chance, #listener#. Here it is. I am sorry.",
        "#listener# — I was the one who broke it. Let me be the one who asks to mend it.",
        "Keep the grudge if you must, #listener#. But know I set down my half of #referent# in shame."
    ],

    // --- RECRUIT, coloured ---
    "recruit/enraptured": [
        "Come to the temple with me, #listener#. #bliss_phrase#. You have to feel it for yourself.",
        "There is room in the light for you, #listener#. I have seen it. Walk toward it with me.",
        "Stop dreaming the grey, #listener#, and dream the god instead. I will show you the way in.",
        "#listener# — give yourself to it as I did. #bliss_phrase#. You will never be cold again.",
        "I cannot keep this joy to myself, #listener#. Come. Let the temple remake you too."
    ],
    "recruit/restless": [
        "Walk to the edge of the fog with me, #listener#. I am going whether you come or not — but come.",
        "Two sets of feet cross the grey faster than one, #listener#. Throw in with me.",
        "There is a far country, #listener#, and I am done waiting for leave to find it. Join me.",
        "I cannot promise where, #listener#, only that it is away from here. That is enough for me."
    ],

    // --- GOSSIP, coloured ---
    "gossip/dreading": [
        "Keep this between us, #listener#. They are saying one of the seven walked the fog as a man.",
        "I should not pass this on, #listener#, but souls near the fog-line are simply… not there anymore.",
        "Do not look around when I say it, #listener#. The mist has been taking the ones who ask questions.",
        "I heard it twice now, #listener#, from two mouths that did not know each other. That is the frightening part.",
        "#address# Low voice, #listener#. What I heard about #referent# is the kind of thing they silence."
    ],
    "gossip/envious": [
        "You hear how the wheel smiled on #referent#, #listener#? Some souls get every turn their way.",
        "They say #referent# rose without earning a step of it, #listener#. Some of us noticed.",
        "Funny, how the fog parts for some and not others, #listener#. I will let you guess who.",
        "Word is #referent# sits pretty now, #listener#. Strange, the souls fortune chooses."
    ],

    // --- DEFLECT, coloured ---
    "deflect/contemptuous": [
        "No, #listener#. #void_aside#. Go and bother the fog with it.",
        "You came to the wrong soul, #listener#. I have no interest and less patience.",
        "I have heard you. I have decided you are not worth answering, #listener#. That is all.",
        "Spend your breath elsewhere, #listener#. It is worth more to you than to me.",
        "#listener#, whatever this is — no. Find a soul who still pretends to care."
    ],
    "deflect/despairing": [
        "What would be the point, #listener#. Nothing here changes anything.",
        "Ask the mist, #listener#. It is as likely to answer as I am, and it cares as much.",
        "I have no answers left, #listener#. I spent the last of them on a wheel that would not turn.",
        "Leave it, #listener#. Leave me. It is easier to be no one in this grey.",
        "#world_aside#, #listener#. So why would I waste what is left of me on it."
    ],
    "deflect/restless": [
        "Not now, #listener#. My feet are already gone, even if the rest of me is still talking to you.",
        "Catch me at the next ridge, #listener#, if the fog has not swallowed it. Not here.",
        "I cannot stand still long enough for this, #listener#. Walk and talk, or let it go.",
        "Some other grey hour, #listener#. The road is calling louder than you are."
    ],

    // =====================================================================================
    // EXPANSION II — the remaining sensible act/affect buckets, so every feeling the engine
    // can emit has a voice in nearly every act it makes sense for. Still additive: an absent
    // combination simply falls back to the bare act.
    // =====================================================================================

    // --- GREET, further moods ---
    "greet/angry": [
        "What do you want, #listener#. Be quick. My patience burned off in the fog hours ago.",
        "#listener#. I have nothing warm for you today. Say your piece.",
        "You picked a poor moment, #listener#. Speak, then leave me to the grey.",
        "#address# #listener#. I am not in a mood to be met. But here you are."
    ],
    "greet/grieving": [
        "#listener#. Forgive me — I am not myself. I have lost someone to the mist.",
        "You catch me hollow, #listener#. Speak gently, or not at all.",
        "#listener#. I would greet you properly, but the grief has taken my manners with the rest.",
        "I am glad it is you, #listener#, and sorry it is anyone. I am poor company tonight."
    ],
    "greet/enraptured": [
        "#listener#! The light is so near today — can you not feel it? Walk with me in it.",
        "Bless the fog for bringing you, #listener#. Everything is luminous, and I want to share it.",
        "#listener# — I have been singing inwardly all morning. The god is close. Sit, sit.",
        "You arrive on a holy hour, #listener#. Even the grey looks gilded to me now."
    ],
    "greet/contemptuous": [
        "#listener#. So it is you. I had hoped the fog would keep you a while longer.",
        "You again, #listener#. The grey does scrape the bottom of its barrel.",
        "Make it brief, #listener#. I have better uses for the mist than your company.",
        "#listener#. I will give you the nod the moment costs me and not a breath more."
    ],

    // --- ACCUSE, hopeless ---
    "accuse/despairing": [
        "You did #referent#, #listener#, and I no longer have the strength even to rage at it.",
        "I should hate you for #referent#, #listener#. I am too tired. That, too, is what you took.",
        "#referent#, #listener#. And the worst of it is that I expected it. I expect everything now.",
        "What does it matter that you did #referent#, #listener#. Nothing matters in this grey. Not even that.",
        "I name #referent# only so it is said once, #listener#. Then I will let the fog have it, like the rest."
    ],

    // --- THREATEN, nothing-left ---
    "threaten/despairing": [
        "I have nothing left, #listener#, which makes me more dangerous than you know. Step back.",
        "Take what you want, #listener#. But know I will burn it down on my way out of this fog.",
        "I am past saving and past caring, #listener#. Do not give me a reason. I have so few left.",
        "You think I fear consequences, #listener#? I already lost the only things I feared for."
    ],

    // --- PLEAD, ashamed ---
    "plead/guilty": [
        "I have no right to ask you anything, #listener#, after #referent#. And still I am asking.",
        "Help me, #listener# — I know what I did. Let me make some small thing right.",
        "#listener#, I do not deserve it, and that is exactly why I beg. Give me the chance to mend it.",
        "I carry #referent# like a stone, #listener#. I am not asking you to lift it — only to stand near while I try."
    ],

    // --- CONFIDE, further moods ---
    "confide/warm": [
        "Come close, #listener#. I have something I would say only to a friend, and you are the one I have.",
        "I trust you, #listener#. Plainly, warmly, the way one rarely can in this grey. So — listen.",
        "Between us, and gladly between us, #listener# — here is a thing I have been keeping.",
        "It feels lighter already, telling you, #listener#. That is what you are to me.",
        "#listener#, I have carried this a while, and there is no one I would rather set it down with."
    ],
    "confide/grieving": [
        "I have to tell someone before the fog takes it too, #listener#. They are gone. I am undone.",
        "Hold this with me, #listener#. I cannot carry the grief and the silence both.",
        "#listener# — I am not strong tonight. Let me speak the loss aloud to one who will not flinch.",
        "I trusted you with everything else, #listener#. Let me trust you with the breaking, too."
    ],
    "confide/despairing": [
        "I am telling you because there is no one else, #listener#, and because nothing matters enough to hide.",
        "Listen, or do not, #listener#. I will say it either way. I have stopped hoping it changes anything.",
        "#listener# — I have given up. There. Now someone knows. Do with it what the fog allows.",
        "I used to fear saying this aloud, #listener#. I have run out of the strength even to fear it."
    ],
    "confide/lonely": [
        "I have not spoken a true word to anyone in so long, #listener#. Let it be you. Please, let it be you.",
        "#listener# — I will tell you a secret only because I cannot stand the silence of keeping it alone.",
        "Stay a moment and I will trust you with something, #listener#. The trusting is half for the company.",
        "I have held this alone too long, #listener#. Loneliness makes a poor vault. Here — take some of it."
    ],

    // --- CONSOLE, further moods ---
    "console/longing": [
        "I know that ache, #listener#. It is not only grief — it is the pull toward #home_phrase#. I feel it too.",
        "You are not wrong to yearn, #listener#. There was somewhere truer. Hold to that. I will hold it with you.",
        "Let yourself miss it, #listener# — the home behind the fog. The longing is the realest part of us.",
        "#listener#, the wanting itself is a kind of memory. Do not let the mist shame you out of it. I am here."
    ],
    "console/afraid": [
        "Breathe, #listener#. I have you. Whatever moves in the fog, it has to pass me first.",
        "You are safe in this moment, #listener#. I will not pretend the grey is kind, but right now you are safe.",
        "#listener# — look at me, not the mist. There. Stay with my voice. The fear passes. I have seen it pass.",
        "I am frightened too, #listener#. But less, with you here. Let us be less afraid together."
    ],
    "console/despairing": [
        "I will not tell you it gets better, #listener#. Only that I am staying. That is all I have, and it is yours.",
        "You do not have to hope tonight, #listener#. Let me hold the hoping. You only have to keep breathing.",
        "#listener# — I know the bottom of it. I have been there. I came back far enough to reach down for you.",
        "It is enough to still be here, #listener#. That is the whole task tonight. Nothing more. I am here for it."
    ],

    // --- MOURN, further moods ---
    "mourn/dreading": [
        "They are gone, #listener#, and the way they went — I think the seven had a hand in it. I am afraid to say more.",
        "I grieve, #listener#, and beneath the grief is a colder thing: the sense that we are next.",
        "#listener# — I mourn them, and I watch the fog, because I do not think it is finished taking.",
        "The loss frightens me more than it should, #listener#. As if it were a warning, not an ending."
    ],
    "mourn/guilty": [
        "They are gone, #listener#, and I keep thinking of the words I never said. The silence is mine to keep now.",
        "I mourn them, #listener#, and cannot stop counting the times I failed them. The grief has a sharp edge.",
        "#listener# — I should have done more. I know it the way I know my own name. And now there is only the after.",
        "It is not clean grief, #listener#. It is tangled with all I did and did not do. That is the worst kind."
    ],

    // --- PRAISE, further moods ---
    "praise/calm": [
        "You did well, #listener#. I only wanted to say it, quietly, before the fog swallows the chance.",
        "There is a steadiness in you, #listener#, that this grey place does not deserve and badly needs.",
        "#listener# — no fanfare. Only this: I have watched you, and you are good. That is worth a calm word.",
        "I think you do not hear it enough, #listener#, so hear it from me, plainly: you are doing well."
    ],
    "praise/grieving": [
        "Even hollowed out as I am, #listener#, I can see what you did, and it was kind. Thank you for it.",
        "#listener# — I have little left in me, but what is left wants to say you were a light in this. Truly.",
        "I am grieving and still grateful, #listener#. You stood by when you did not have to. I will not forget it.",
        "Through all of it, #listener#, you were good to me. I needed to say so while I still can."
    ],

    // --- RECONCILE, further moods ---
    "reconcile/grieving": [
        "We have both lost too much to keep this between us, #listener#. Let the grudge go where the dead went.",
        "#listener# — grief has made the quarrel small. I cannot hold #referent# against you over an open grave.",
        "I am too emptied to be your enemy, #listener#. Let us mourn instead of feud. There is more than enough to mourn.",
        "The mist took what we fought over, #listener#. Let it take the fighting, too. Stand with me in this loss."
    ],
    "reconcile/lonely": [
        "I am so tired of being alone in the grey, #listener#, that even our old quarrel feels like warmth. Let us end it.",
        "#listener# — I would rather have you as a friend than be right and be alone. Come back.",
        "The loneliness taught me what #referent# was worth, #listener#: nothing, beside a face that knows me.",
        "I have run out of souls to be proud in front of, #listener#. Let us put it down. Please."
    ],

    // --- RECRUIT, further moods ---
    "recruit/dreading": [
        "Something is coming, #listener#, and I cannot meet it alone. Stand with me before it arrives.",
        "#listener# — the fog is hunting, and the hunted who band together last longer. Throw in with me.",
        "I do not ask lightly, #listener#: there is a shadow over us, and I want you at my back when it falls.",
        "Keep your voice down and say yes, #listener#. We are safer as two. The seven pick off the solitary."
    ],
    "recruit/angry": [
        "I am done being ground down quietly, #listener#. Are you? Then stand with me and we push back.",
        "#listener# — they have taken enough. Help me make them regret the next thing they reach for.",
        "Put your anger to use, #listener#. Mine alone is a spark. Ours together could be a fire.",
        "I will not kneel to the grey another day, #listener#. Rise with me. Let us give them something to fear."
    ],

    // --- GOSSIP, mocking ---
    "gossip/contemptuous": [
        "You hear what #referent# has been telling people, #listener#? Pitiful. I almost feel for them. Almost.",
        "#listener# — they say #referent# fancies themselves important now. The fog does breed delusions.",
        "Let me spare you the trouble of being impressed by #referent#, #listener#. I have the real story.",
        "Word is #referent# tripped over their own pride again, #listener#. Some souls never tire of the show."
    ],

    // --- DEFLECT, further moods ---
    "deflect/afraid": [
        "Not here, #listener#. Not where the mist can carry it. Ask me nothing. Please.",
        "#listener# — I cannot talk about this. I cannot. Do not make me. The fog has ears.",
        "Leave it, #listener#, for both our sakes. Some questions are dangerous to have answered near the seven.",
        "I will not, #listener#. Not because I distrust you — because I am afraid of who else might be listening."
    ],
    "deflect/grieving": [
        "Not now, #listener#. I have nothing left to give a conversation. The grief has all of me.",
        "#listener# — please. I cannot. Whatever it is, it will have to wait until I can stand upright again.",
        "Forgive me, #listener#. I am no use to anyone today. Let me be hollow in peace.",
        "I hear you, #listener#, I do. I simply have no words left that are not about the one I lost."
    ]
}
