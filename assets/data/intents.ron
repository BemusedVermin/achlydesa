    ),

    // The oblivion-blanket — a soul too deep in the dream gives a flat, forgetting dismissal
    (
        id: "a_forgetting_dismissal",
        act: Deflect,
        tags: ["false-comfort", "oblivion"],
        weight: 0.8,
