    // === The landmarks of the purgatory: the cult, the seven, the wells of forgetting ===

    // --- Communities of the fog-bound dead ---

    // A town submerged in mist and low memory — its settlers neither alive nor truly
    // dead, clinging to the shore of forgetting. Low fertility keeps it marginal.
    (
        name: "mist_drowned_town", category: Community, discovery: Landmark, density: 0.04,
        favoured: [
            (signal: SurfaceWater, curve: Logistic(mid: 0.015, k: 180.0)),
            (signal: Aridity, curve: Linear(m: -0.5, b: 0.8)),
            (signal: Fertility, curve: Logistic(mid: 0.01, k: 300.0)),
        ],
    ),
    // A waystation on the pilgrim road — souls walking toward the Demiurge's great
    // temple are offered shelter here by the cult's wardens. Inexhaustible rest.
    (
        name: "pilgrim_waystation", category: Community, discovery: Landmark, density: 0.05,
        favoured: [
            (signal: Grass, curve: Linear(m: 0.5, b: 0.5)),
            (signal: Slope, curve: Linear(m: -0.003, b: 0.9)),
            (signal: Fertility, curve: Logistic(mid: 0.012, k: 200.0)),
        ],
        affordances: [(action: "shelter", effect: Relieve(need: Rest, amount: 50))],
    ),
    // A charnel-town of the forsaken dead — too wretched to be settled, too haunted
    // to be abandoned. Aridity and isolation define it; fertility is near nothing.
    (
        name: "lazaret", category: Community, discovery: Hidden, density: 0.025,
        favoured: [
            (signal: Aridity, curve: Logistic(mid: 0.7, k: 10.0)),
            (signal: Remoteness, curve: Logistic(mid: 0.55, k: 7.0)),
            (signal: Fertility, curve: Logistic(mid: 0.006, k: 350.0)),
        ],
    ),

    // --- Courts of the cult and the seven ---

    // The seat of the Demiurge's worship: a blind eye carved above the door, altars
    // running with false gold. Found inside any settlement large enough to serve it.
    // The cult teaches weaving — the shroud-work of the dead.
    (
        name: "temple_of_the_demiurge", category: Court, discovery: Landmark, density: 0.45,
        host: Some(Community),
        favoured: [
            (signal: Fertility, curve: Constant(0.6)),
        ],
        affordances: [(action: "apprentice", effect: Teach(skill: "weaving"))],
    ),
    // Throne of one of the seven Archons — Athoth, Eloaiou, Astaphaios, Yao, Sabaoth,
    // Adonin, Sabbede — a beast-faced jailer anchored to high, remote ground. Secret:
    // the Archon reveals itself only to those who seek.
    (
        name: "archon_throne", category: Court, discovery: Secret, density: 0.02,
        favoured: [
            (signal: Elevation, curve: Logistic(mid: 900.0, k: 0.004)),
            (signal: Remoteness, curve: Logistic(mid: 0.65, k: 9.0)),
            (signal: Slope, curve: Logistic(mid: 220.0, k: 0.02)),
        ],
    ),
    // A hidden order that administers the cup of forgetfulness — embedded in towns,
    // masked as a hospice. The souls who pass through remember nothing after.
    (
        name: "cult_of_forgetting", category: Court, discovery: Secret, density: 0.25,
        host: Some(Community),
        favoured: [
            (signal: Fertility, curve: Logistic(mid: 0.02, k: 130.0)),
            (signal: SurfaceWater, curve: Logistic(mid: 0.01, k: 200.0)),
        ],
    ),
    // A seer's seat: a blind oracle who speaks the Archons' riddles and the passwords
    // of fate. The seers do not free — they test. Found hidden at elevation.
    (
        name: "seers_seat", category: Court, discovery: Hidden, density: 0.04,
        favoured: [
            (signal: Elevation, curve: Logistic(mid: 700.0, k: 0.004)),
            (signal: Remoteness, curve: Logistic(mid: 0.45, k: 7.0)),
            (signal: Slope, curve: Logistic(mid: 160.0, k: 0.02)),
        ],
    ),

    // --- Ruins of myth and the failed ascent ---

    // A vault of bones beneath the community — the cult stores the unnamed dead here,
    // sealed with wax and the Demiurge's sigil. Secret: you must know what to look for.
    (
        name: "ossuary", category: Ruin, discovery: Secret, density: 0.35,
        host: Some(Community),
        favoured: [
            (signal: Fertility, curve: Constant(0.5)),
        ],
    ),
    // A ruined archway where souls once tried to speak the seven passwords and ascend.
    // Most failed; the gate is broken. Remote, hidden in the wastes.
    (
        name: "gate_of_the_seven", category: Ruin, discovery: Hidden, density: 0.015,
        favoured: [
            (signal: Remoteness, curve: Logistic(mid: 0.65, k: 9.0)),
            (signal: Aridity, curve: Logistic(mid: 0.6, k: 10.0)),
            (signal: Elevation, curve: Logistic(mid: 500.0, k: 0.004)),
        ],
    ),
    // A forgotten shrine to a power the Archons swallowed — cracked stone, a hollow
