    (
        name: "forgotten_shrine", category: Ruin, discovery: Hidden, density: 0.03,
        favoured: [
            (signal: Grass, curve: Linear(m: 0.6, b: 0.4)),
            (signal: Remoteness, curve: Linear(m: 0.35, b: 0.45)),
            (signal: Slope, curve: Linear(m: -0.004, b: 1.0)),
        ],
    ),
    // A reliquary half-swallowed by water — sacred objects of the old world, submerged
    // and slowly dissolving. Found where water pools in flat ground.
    (
        name: "drowned_reliquary", category: Ruin, discovery: Hidden, density: 0.025,
        favoured: [
            (signal: SurfaceWater, curve: Logistic(mid: 0.05, k: 45.0)),
            (signal: Slope, curve: Linear(m: -0.004, b: 1.0)),
            (signal: Remoteness, curve: Linear(m: 0.3, b: 0.5)),
        ],
    ),
    // A toppled idol of the lion-faced god — the Demiurge's own boast, pulled down by
    // someone who knew better. Its face is still turned toward the false heaven.
    (
        name: "pillar_of_the_boast", category: Ruin, discovery: Landmark, density: 0.018,
        favoured: [
            (signal: Remoteness, curve: Logistic(mid: 0.6, k: 8.0)),
            (signal: Aridity, curve: Logistic(mid: 0.75, k: 10.0)),
            (signal: Slope, curve: Linear(m: -0.003, b: 0.9)),
        ],
    ),

    // --- Wilderness of the purgatory: wonders, hazards, and sacred wounds ---

    // A spring whose water makes the drinker forget — the false rest of oblivion.
    // Drinking relieves the burden of memory (modelled as Rest). Depletable but
    // the forgetting seeps back up; slow regen. Found where aridity meets water.
    (
        name: "well_of_lethe", category: Wilderness, discovery: Hidden, density: 0.025,
        favoured: [
            (signal: SurfaceWater, curve: Logistic(mid: 0.03, k: 80.0)),
            (signal: Aridity, curve: Logistic(mid: 0.65, k: 11.0)),
        ],
        affordances: [(action: "drink", effect: Relieve(need: Rest, amount: 60), capacity: 20, regen: 0.3)],
    ),
    // Where the veil between this world and the Pleroma has split — a wound of true
    // light, utterly remote. The director reveals it; no soul finds it by accident.
    // No affordance: it does not serve the simulation, it calls to it.
    (
        name: "rift_of_the_pleroma", category: Wilderness, discovery: Secret, density: 0.006,
        favoured: [
            (signal: Remoteness, curve: Logistic(mid: 0.8, k: 12.0)),
            (signal: Elevation, curve: Logistic(mid: 1100.0, k: 0.004)),
            (signal: Slope, curve: Logistic(mid: 200.0, k: 0.02)),
        ],
    ),
    // A forest of ash — trees dead so long their bark has gone white. Foraging yields
    // little, slowly. The grove is a quiet horror: every tree is a memory.
    (
        name: "grove_of_ash", category: Wilderness, discovery: Landmark, density: 0.04,
        favoured: [
            (signal: Forest, curve: Linear(m: 1.0, b: 0.0)),
            (signal: Aridity, curve: Logistic(mid: 0.55, k: 9.0)),
            (signal: Remoteness, curve: Linear(m: 0.3, b: 0.4)),
        ],
        affordances: [(action: "forage", effect: Relieve(need: Sustenance, amount: 20), capacity: 15, regen: 0.2)],
    ),
    // A flat mirror of standing water — fog never lifts from it. Faces of the drowned
    // appear in its surface. Dangerous stillness.
    (
        name: "mirror_marsh", category: Wilderness, discovery: Landmark, density: 0.03,
        favoured: [
            (signal: SurfaceWater, curve: Logistic(mid: 0.06, k: 40.0)),
            (signal: Slope, curve: Linear(m: -0.004, b: 1.0)),
            (signal: Aridity, curve: Linear(m: -0.4, b: 0.8)),
        ],
    ),
    // Stones that ring like struck bone when the wind passes — the drowned choir of
    // souls who never reached the gate. Remote uplands, flat enough for the stones.
    (
        name: "choir_of_the_drowned", category: Wilderness, discovery: Hidden, density: 0.02,
        favoured: [
            (signal: Grass, curve: Linear(m: 0.6, b: 0.3)),
            (signal: Remoteness, curve: Logistic(mid: 0.55, k: 8.0)),
            (signal: Slope, curve: Linear(m: -0.003, b: 0.9)),
        ],
    ),
    // A lone flame on a high rock — no fire is fed, yet it burns. The Archons' pilots
    // use it to keep souls from straying off the grid of heimarmene.
    (
        name: "pale_beacon", category: Wilderness, discovery: Landmark, density: 0.02,
        favoured: [
            (signal: Elevation, curve: Logistic(mid: 1000.0, k: 0.004)),
            (signal: Remoteness, curve: Logistic(mid: 0.6, k: 8.0)),
            (signal: Slope, curve: Logistic(mid: 180.0, k: 0.02)),
        ],
    ),

    // === A wider world: more waypoints, more terrain ===

    // --- Communities: new settlements of the fog-bound dead ---

    // A handful of hovels scraped from a salt flat — settlers who could go no further
    // and stopped. The crust glitters, the air tastes of brine. Low fertility, arid.
    (
        name: "salt_flat_hamlet", category: Community, discovery: Landmark, density: 0.04,
        favoured: [
            (signal: Aridity, curve: Logistic(mid: 0.7, k: 10.0)),
            (signal: Slope, curve: Linear(m: -0.003, b: 0.9)),
            (signal: Fertility, curve: Logistic(mid: 0.007, k: 320.0)),
        ],
    ),
    // Refugees from a failed ascent who clustered in a gulch — tents and lean-tos,
    // the ash-smell of defeat. Hidden: not on any cult map.
    (
        name: "refugee_camp", category: Community, discovery: Hidden, density: 0.035,
        favoured: [
            (signal: Remoteness, curve: Logistic(mid: 0.45, k: 7.0)),
            (signal: Slope, curve: Logistic(mid: 100.0, k: 0.018)),
            (signal: Fertility, curve: Logistic(mid: 0.009, k: 260.0)),
        ],
        affordances: [(action: "shelter", effect: Relieve(need: Rest, amount: 35))],
    ),
    // A walled leper-colony kept at the cult's margin — the afflicted dead who retain
    // some faint memory of sickness, isolated on the fringe of a community.
    (
        name: "leper_colony", category: Community, discovery: Hidden, density: 0.03,
        host: Some(Community),
        favoured: [
            (signal: Aridity, curve: Logistic(mid: 0.5, k: 8.0)),
            (signal: Fertility, curve: Logistic(mid: 0.01, k: 220.0)),
        ],
    ),
    // Dwellings notched into a sea-cliff — the dead who remember the sea cling here,
    // watching fog-water for shapes that never arrive. Coast is a hard requirement.
    (
        name: "cliff_roost", category: Community, discovery: Landmark, density: 0.04,
        favoured: [
            (signal: Coast, curve: Linear(m: 1.0, b: 0.0)),
            (signal: Slope, curve: Logistic(mid: 200.0, k: 0.02)),
            (signal: Fertility, curve: Logistic(mid: 0.008, k: 280.0)),
        ],
        affordances: [(action: "shelter", effect: Relieve(need: Rest, amount: 30))],
    ),
    // Stilted platforms above a brackish fen — the soil is black and sick, but the
    // reed-beds give weaving-fibre and the community persists. Low flat water.
    (
