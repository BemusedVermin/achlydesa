            (signal: Slope, curve: Linear(m: -0.004, b: 1.0)),
        ],
    ),
    (
        name: "barrow", category: Ruin, discovery: Hidden, density: 0.03,
        favoured: [
            (signal: Grass, curve: Linear(m: 0.5, b: 0.5)),
            (signal: Remoteness, curve: Linear(m: 0.4, b: 0.4)),
            (signal: Slope, curve: Linear(m: -0.003, b: 0.9)),
        ],
